# Get a key from https://openrouter.ai/ — never commit the real .env file.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx
# Optional: override default model (server defaults to openai/gpt-4o-mini)
OPENROUTER_MODEL=openai/gpt-4o-mini

# Local dev: Vite proxies /api to this origin (default http://localhost:CHAT_API_PORT)
# CHAT_API_PORT=3001
# CHAT_API_ORIGIN=http://localhost:3001

# Production (e.g. Vercel): public site URL for OpenRouter HTTP-Referer (optional)
# PUBLIC_SITE_URL=https://your-app.vercel.app

# Optional: browser override (same names with VITE_ are not used for the key; key stays server-side)
# VITE_OPENROUTER_MODEL=openai/gpt-4o-mini
